# The login screen: mellagui-greetd on the first text console (docs/GREETER.md).
# `make install` puts this file (with @BINDIR@ replaced) in /etc/systemd/system, the rest of the login screen next to it;
# `make enable-greeter` takes tty1 away from getty and the other display managers and enables this unit.
[Unit]
Description=MellaGUI login screen
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-logind.service getty@tty1.service
Conflicts=getty@tty1.service
Wants=systemd-logind.service

[Service]
Type=simple
Environment=PATH=@BINDIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@BINDIR@/mellagui-greetd --vt 1
Restart=always
RestartSec=2
IgnoreSIGPIPE=no
SendSIGHUP=yes
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
Alias=display-manager.service
WantedBy=graphical.target
